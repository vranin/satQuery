# SatQuery Backend — Environment Variables
# Copy this file to .env and fill in values

# --- Model Configuration ---
# The VLM backend to use: "ollama" | "huggingface" | "remote"
VLM_BACKEND=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava:7b

# --- Data Paths ---
# Path to BigEarthNet data directory (relative to backend/)
BIGEARTHNET_DATA_DIR=data/bigearthnet
# Optional small CSV/JSON annotation export keyed by sample_id or patch_id.
BIGEARTHNET_ANNOTATIONS_FILE=

# Path to output directory for processed images
OUTPUT_DIR=outputs

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# --- Logging ---
LOG_LEVEL=INFO
